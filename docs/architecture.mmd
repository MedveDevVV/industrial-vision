flowchart TD
    VIDEO["Источник видеопотока<br/>Камера или видеофайл"]
    CAP["Capture<br/>Получение кадров"]
    INF["Inference<br/>Обнаружение объектов моделью"]
    TRK["Tracking<br/>Отслеживание объектов между кадрами"]
    ZON["Zones<br/>Проверка попадания объектов в зоны"]
    ANA["Analytics<br/>Расчёт статистики и показателей"]
    EVT["Events<br/>Формирование событий"]
    API["API<br/>Передача результатов наружу"]

    CFG[("configs/<br/>Настройки приложения")]
    LOG["Logging<br/>Журналы работы и ошибок"]
    MON["Monitoring<br/>Состояние и производительность"]

    VIDEO --> CAP --> INF --> TRK --> ZON --> ANA --> EVT --> API
    CFG -. "настройки" .-> CAP
    CFG -. "настройки" .-> INF
    CFG -. "настройки" .-> ZON
    CAP -. "события и ошибки" .-> LOG
    INF -. "события и ошибки" .-> LOG
    TRK -. "события и ошибки" .-> LOG
    API -. "состояние сервиса" .-> MON
    INF -. "нагрузка" .-> MON
